; Окно мира Matricaria (версия 0.3.5).
; Godot только рисует и передаёт намерения игрока; мир хранит и меняет Python-ядро (D4).

config_version=5

[application]

config/name="Matricaria"
config/description="Window into the Matricaria world core"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")

[display]

window/size/viewport_width=1280
window/size/viewport_height=760
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
